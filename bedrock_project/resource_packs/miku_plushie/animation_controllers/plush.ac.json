{
  "format_version": "1.12.0",
  "animation_controllers": {
    "controller.animation.plush.main": {
      "initial_state": "spawning",
      "states": {
        "spawning": {
          "animations": ["spawn"],
          "transitions": [
            { "idle": "q.life_time > 0.5" }
          ]
        },
        "idle": {
          "animations": ["idle", "walk"],
          "transitions": [
            { "sitting": "q.is_sitting" },
            { "dancing": "v.is_dancing && !q.is_sitting" },
            { "attacking": "q.is_delayed_attacking" }
          ]
        },
        "sitting": {
          "animations": ["sit"],
          "transitions": [
            { "sit_dancing": "v.is_dancing && q.is_sitting" },
            { "idle": "!q.is_sitting" }
          ]
        },
        "sit_dancing": {
          "animations": ["sit_dance"],
          "transitions": [
            { "sitting": "!v.is_dancing" },
            { "idle": "!q.is_sitting" }
          ]
        },
        "dancing": {
          "blend_transition": 0.1,
          "transitions": [
            { "idle": "!v.is_dancing" },
            { "attacking": "q.is_delayed_attacking" }
          ]
        },
        "attacking": {
          "animations": ["swipe"],
          "blend_transition": 0.1,
          "transitions": [
            { "idle": "!q.is_delayed_attacking" }
          ]
        }
      }
    },
    "controller.animation.plush.hair": {
      "initial_state": "default",
      "states": {
        "default": {}
      }
    },
    "controller.animation.miku.eat": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "eating": "v.is_eating" }
          ]
        },
        "eating": {
          "animations": ["eat"],
          "transitions": [
            { "default": "!v.is_eating" }
          ]
        }
      }
    },
    "controller.animation.plush.dance_select": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "caramelldansen": "v.is_dancing && v.dance_index == 0" },
            { "miku_dance": "v.is_dancing && v.dance_index == 1" },
            { "ievan_polkka": "v.is_dancing && v.dance_index == 2" },
            { "vegetable_juice": "v.is_dancing && v.dance_index == 3" },
            { "static_dance": "v.is_dancing && v.dance_index == 4" }
          ]
        },
        "caramelldansen": {
          "animations": ["caramelldansen"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "miku_dance": {
          "animations": ["miku_dance"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "ievan_polkka": {
          "animations": ["ievan_polkka"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "vegetable_juice": {
          "animations": ["vegetable_juice"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "static_dance": {
          "animations": ["static_dance"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        }
      }
    },
    "controller.animation.teto.dance_select": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "caramelldansen": "v.is_dancing && v.dance_index == 0" },
            { "teto_territory": "v.is_dancing && v.dance_index == 1" },
            { "birdbrain": "v.is_dancing && v.dance_index == 2" },
            { "liar_dancer": "v.is_dancing && v.dance_index == 3" }
          ]
        },
        "caramelldansen": {
          "animations": ["caramelldansen"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "teto_territory": {
          "animations": ["teto_territory"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "birdbrain": {
          "animations": ["birdbrain"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        },
        "liar_dancer": {
          "animations": ["liar_dancer"],
          "transitions": [
            { "default": "!v.is_dancing" }
          ]
        }
      }
    }
  }
}
