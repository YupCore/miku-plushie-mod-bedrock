{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "miku:akita_neru_plush",
      "enable_attachables": true,
      "materials": {
        "default": "entity_alphatest",
        "ghost": "entity_alphablend"
      },
      "textures": {
        "default": "textures/blocks/akita_neru_plush",
        "tails": "textures/blocks/akita_neru_plush_tails"
      },
      "geometry": {
        "default": "geometry.akita_neru_plush_entity"
      },
      "animations": {
        "idle": "animation.plush.misc.idle",
        "sit": "animation.plush.misc.sit",
        "sit_dance": "animation.plush.misc.sit-dance",
        "spawn": "animation.plush.misc.spawn",
        "swipe": "animation.plush.attack.swipe",
        "swipe2": "animation.plush.attack.swipe2",
        "swipe3": "animation.plush.attack.swipe3",
        "caramelldansen": "animation.plush.misc.dance.generic.caramelldansen",
        "ievan_polkka": "animation.plush.misc.dance.miku.ievan_polkka",
        "vegetable_juice": "animation.plush.misc.dance.miku.vegetable_juice",
        "procedural_pose": "animation.plush.procedural.pose",
        "hair_procedural": "animation.plush.procedural.hair",
        "main_controller": "controller.animation.plush.main",
        "hair_controller": "controller.animation.plush.hair",
        "procedural_pose_controller": "controller.animation.plush.procedural_pose",
        "dance_select": "controller.animation.neru.dance_select"
      },
      "scripts": {
        "pre_animation": [
          "v.variant = q.property('miku:variant');",
          "v.health_bend = (1 - q.health / q.max_health) * 35 ;",
          "v.walk_phase = q.modified_distance_moved * 57.3;",
          "v.walk_phase2 = v.walk_phase * 2;",
          "v.walk_target = math.min(q.modified_move_speed * 4.0, 1.0);",
          "v.walk_amp = v.walk_amp + (v.walk_target - v.walk_amp) * 0.4;",
          "v.head_x = q.head_x_rotation(0);",
          "v.head_y = math.clamp(math.min_angle(q.head_y_rotation(0) - q.body_y_rotation), -85, 85);",
          "v.enable_hair_proc = 1;"
        ],
        "animate": [
          "main_controller",
          "dance_select",
          "procedural_pose_controller",
          "hair_controller"
        ]
      },
      "render_controllers": [
        "controller.render.neru_plush"
      ]
    }
  }
}
